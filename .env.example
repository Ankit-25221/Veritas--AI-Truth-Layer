# ── Backend API Keys ────────────────────────────────────────────
# Get from: https://ai.google.dev/
GOOGLE_API_KEY=your_google_api_key_here

# Get from: https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# ── CORS (optional) ─────────────────────────────────────────────
# Set to your deployed frontend URL in production
FRONTEND_URL=https://your-app.onrender.com

# ── Runtime environment ─────────────────────────────────────────
# Set to "production" in prod to disable uvicorn reload
ENV=development

# ── AI Model ────────────────────────────────────────────────────
# gemini-2.0-flash: 1,500 req/day free tier (default — recommended)
# gemini-2.5-flash: 20 req/day free tier (higher quality but very limited)
GEMINI_MODEL=gemini-2.0-flash
